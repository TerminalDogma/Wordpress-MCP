parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$parent_slug of function add_submenu_page expects string, null given\.$#'
			identifier: argument.type
			count: 1
			path: multisite-shared-content/src/Acf.php

		-
			message: '#^Result of function acf_get_field_type \(void\) is used\.$#'
			identifier: function.void
			count: 1
			path: multisite-shared-content/src/Acf.php

		-
			message: '#^Parameter \#1 \$text of function esc_html expects string, int\<0, max\> given\.$#'
			identifier: argument.type
			count: 1
			path: multisite-shared-content/src/Admin.php

		-
			message: '#^Strict comparison using \=\=\= between ''relationship'' and mixed~\(''boolean''\|''json''\|''media''\|''media_list''\|''multiselect''\|''relationship''\|''relationship_list''\|''richtext''\) will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: multisite-shared-content/src/Admin.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(mixed\)\: bool\)\|null, ''strlen'' given\.$#'
			identifier: argument.type
			count: 1
			path: multisite-shared-content/src/CatalogArchive.php

		-
			message: '#^Strict comparison using \!\=\= between null and mixed will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 4
			path: multisite-shared-content/src/EpisodeAdmin.php

		-
			message: '#^Comparison operation "\<" between 0\|1 and 2 is always true\.$#'
			identifier: smaller.alwaysTrue
			count: 1
			path: multisite-shared-content/src/IgdbClient.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: multisite-shared-content/src/IgdbClient.php

		-
			message: '#^Offset ''scheme'' on array\{scheme\: ''http''\|''https'', host\?\: string, port\: int\<0, 65535\>, user\?\: ''''\|''0'', pass\?\: ''''\|''0'', path\?\: string, query\?\: string, fragment\?\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: multisite-shared-content/src/MediaImport.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(mixed\)\: bool\)\|null, ''strlen'' given\.$#'
			identifier: argument.type
			count: 1
			path: multisite-shared-content/src/ReleaseCalendar.php

		-
			message: '#^Strict comparison using \=\=\= between ''rotten_tomatoes'' and ''editorial'' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: multisite-shared-content/src/ReviewScores.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and 9 will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: multisite-shared-content/src/Schema.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 1
			path: multisite-shared-content/src/ScoreImport.php

		-
			message: '#^Strict comparison using \!\=\= between ''msc_game'' and ''msc_game'' will always evaluate to false\.$#'
			identifier: notIdentical.alwaysFalse
			count: 1
			path: multisite-shared-content/src/ScoreImport.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(mixed\)\: bool\)\|null, ''strlen'' given\.$#'
			identifier: argument.type
			count: 1
			path: multisite-shared-content/src/Taxonomies.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(string\)\: bool\)\|null, ''strlen'' given\.$#'
			identifier: argument.type
			count: 2
			path: multisite-shared-content/src/Taxonomies.php

		-
			message: '#^Call to an undefined method DOMNameSpaceNode\|DOMNode\:\:getAttribute\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: multisite-shared-content/src/WikipediaScores.php

		-
			message: '#^Offset 1 on array\{non\-falsy\-string, string, non\-empty\-string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: multisite-shared-content/src/WikipediaScores.php

		-
			message: '#^Offset int\<1, max\> on array\{\}\|array\{string\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: multisite-shared-content/src/WikipediaScores.php

		-
			message: '#^Property WP_Term\:\:\$name \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 1
			path: wp-content/themes/msc-screening-room/functions.php

		-
			message: '#^Strict comparison using \=\=\= between null and mixed will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: wp-content/themes/msc-screening-room/functions.php

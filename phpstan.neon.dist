includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- phpstan-baseline.neon
parameters:
	level: 5
	phpVersion:
		min: 80200
		max: 80499
	paths:
		- multisite-shared-content/multisite-shared-content.php
		- multisite-shared-content/uninstall.php
		- multisite-shared-content/src
		- wp-content/themes/msc-screening-room/functions.php
		- wp-content/themes/msc-screening-room/inc
	bootstrapFiles:
		- tools/phpstan/bootstrap.php
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
	treatPhpDocTypesAsCertain: false

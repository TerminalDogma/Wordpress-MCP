            "poster": {
                "type": "media"
            },
            "promotional_images": {
                "type": "media_list"
            },
            "official_website": {
                "type": "url"
            },
            "number_of_seasons": {
                "type": "integer",
                "min": 0
            },
            "number_of_episodes": {
                "type": "integer",
                "min": 0
            },
            "external_ids": {
                "type": "json"
            }
        }
    },
    "msc_episode": {
        "label": "Episodes",
        "slug": "episodes",
        "archive": true,

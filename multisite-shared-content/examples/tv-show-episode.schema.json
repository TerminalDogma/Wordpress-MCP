        "fields": {
            "title": {
                "type": "text",
                "property": "post_title",
                "label": "Title"
            },
            "content": {
                "type": "richtext",
                "property": "post_content",
                "label": "Description"
            },
            "excerpt": {
                "type": "richtext",
                "property": "post_excerpt",
                "label": "Synopsis"
            },
            "slug": {
                "type": "slug",
                "property": "post_name",
                "label": "URL slug"
            },
            "featured_image": {
                "type": "media"
            },
            "network": {
                "type": "text"
            },
            "streaming_service": {
                "type": "text"
            },
            "seo_title": {
                "type": "text"
            },
            "seo_description": {
                "type": "text"
            },
            "additional_metadata": {
                "type": "json"
            },
            "original_title": {
                "type": "text"
            },
            "status": {
                "type": "text"
            },
            "country": {
                "type": "text"
            },
            "language": {
                "type": "text"
            },
            "premiere_date": {
                "type": "date",
                "indexed": true
            },
            "finale_date": {
                "type": "date",
                "indexed": true
            },
            "genres": {
                "type": "multiselect"

        "fields": {
            "title": {
                "type": "text",
                "property": "post_title",
                "label": "Title"
            },
            "content": {
                "type": "richtext",
                "property": "post_content",
                "label": "Description"
            },
            "excerpt": {
                "type": "richtext",
